# Copy to .env on the VPS and replace every CHANGE_ME value.
# Never commit the real .env file.

ASPNETCORE_ENVIRONMENT=Production
AICARE_DOMAIN=care.example.com
AICARE_API_DOMAIN=api.care.example.com

POSTGRES_DB=aicare
POSTGRES_USER=aicare
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=aicare;Username=aicare;Password=CHANGE_ME_DATABASE_PASSWORD
JwtOptions__Issuer=AiCare
JwtOptions__Audience=AiCareClient
JwtOptions__SigningKey=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
Cors__AllowedOrigins__0=https://care.example.com
FamilyPortal__FrontendBaseUrl=https://care.example.com
Demo__Enabled=false

Storage__Provider=Supabase
Supabase__Url=https://CHANGE_ME.supabase.co
Supabase__ServiceRoleKey=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
Supabase__Bucket=care-documents
Supabase__PublicFileBaseUrl=

Email__Enabled=true
Email__SmtpHost=smtp.hostinger.com
Email__SmtpPort=587
Email__Username=no-reply@care.example.com
Email__Password=CHANGE_ME_HOSTINGER_EMAIL_PASSWORD
Email__FromAddress=no-reply@care.example.com
Email__FromName=AiCare
Email__EnableSsl=true

Monitoring__SlowRequestThresholdMs=2000
Monitoring__AlertWebhookUrl=
