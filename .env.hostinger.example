# Copy to .env on the VPS and replace every CHANGE_ME value.
# Never commit the real .env file.

ASPNETCORE_ENVIRONMENT=Production
AICARE_DOMAIN=care.example.com
AICARE_API_DOMAIN=api.care.example.com

POSTGRES_DB=aicare
POSTGRES_USER=aicare
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=aicare;Username=aicare;Password=CHANGE_ME_DATABASE_PASSWORD
JwtOptions__Issuer=AiCare
JwtOptions__Audience=AiCareClient
JwtOptions__SigningKey=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
Cors__AllowedOrigins__0=https://care.example.com
FamilyPortal__FrontendBaseUrl=https://care.example.com
Frontend__BaseUrl=https://care.example.com
Demo__Enabled=false

Storage__Provider=Supabase
Supabase__Url=https://CHANGE_ME.supabase.co
Supabase__ServiceRoleKey=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
Supabase__Bucket=care-documents
Supabase__PublicFileBaseUrl=

# Resend API handles password resets, invoice PDFs, and queued invitations.
Email__RequiredInProduction=true
Email__Enabled=true
Resend__ApiKey=CHANGE_ME_RESEND_API_KEY
Resend__FromAddress=notifications@care.example.com
Resend__FromName=AI Care
Resend__ReplyToAddress=client@care.example.com

Monitoring__SlowRequestThresholdMs=2000
Monitoring__AlertWebhookUrl=
# Optional. Enables one-time controlled pilot dataset seeding through POST /api/pilot/seed.
# Keep disabled except while seeding, then set back to false after the endpoint succeeds.
PilotSeed__Enabled=false
PilotSeed__Key=CHANGE_ME_LONG_RANDOM_SEED_KEY
PilotSeed__ProviderName=AiCare Controlled Pilot Provider
PilotSeed__AdminEmail=pilot.admin@aicare.local
PilotSeed__AdminPassword=CHANGE_ME_STRONG_PILOT_ADMIN_PASSWORD
