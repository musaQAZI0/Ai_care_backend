# Required for the Render backend service.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_USE_POLLING_FILE_WATCHER=true
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false

# Render Postgres / Supabase Postgres connection string.
# Example:
# Host=db.example.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=

# Use a long random secret, at least 32 characters.
JwtOptions__SigningKey=

# Your deployed frontend URL, for example:
# https://ai-care-frontend.vercel.app
Cors__AllowedOrigins__0=https://ai-care-frontend.vercel.app

# File storage. Use Supabase to store uploaded documents outside Render's temporary filesystem.
Storage__Provider=Supabase
Supabase__Url=
Supabase__ServiceRoleKey=
Supabase__Bucket=care-documents

# Optional. If your bucket is public, this lets /download return a public URL.
# Example:
# https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/care-documents
Supabase__PublicFileBaseUrl=

# Optional. Enables guarded demo seed/reset endpoints.
Demo__Enabled=false
Demo__SeedKey=
# Optional. Enables one-time controlled pilot dataset seeding through POST /api/pilot/seed.
# Keep disabled except while seeding, then set back to false after the endpoint succeeds.
PilotSeed__Enabled=false
PilotSeed__Key=CHANGE_ME_LONG_RANDOM_SEED_KEY
PilotSeed__ProviderName=AiCare Controlled Pilot Provider
PilotSeed__AdminEmail=pilot.admin@aicare.local
PilotSeed__AdminPassword=CHANGE_ME_STRONG_PILOT_ADMIN_PASSWORD
